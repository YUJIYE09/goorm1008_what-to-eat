# Supabase 연결 정보 (Project Settings → API)
# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 넣으세요.
# 비워두면 지금처럼 이 브라우저(LocalStorage)에만 저장하는 모드로 동작해요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 장소 검색 (v0.3) - developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# VITE_ 를 붙이지 않아요: 서버(개발 서버, Vercel 함수)에서만 쓰고 브라우저에는 보내지 않는 비밀 값이에요.
# 비워두면 지금처럼 샘플 식당을 보여줘요.
KAKAO_REST_API_KEY=
